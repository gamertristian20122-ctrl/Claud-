[gd_resource type="AudioBusLayout" format=3]

[sub_resource type="AudioEffectHardLimiter" id="AudioEffectHardLimiter_master"]
resource_name = "HardLimiter"
ceiling_db = -0.5

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_music"]
resource_name = "LowPassFilter"
cutoff_hz = 20500.0
db = 1

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_room"]
resource_name = "Reverb"
predelay_msec = 12.0
predelay_feedback = 0.25
room_size = 0.28
damping = 0.75
spread = 0.6
hipass = 0.25
dry = 1.0
wet = 0.07

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &""
bus/0/effect/0/effect = SubResource("AudioEffectHardLimiter_master")
bus/0/effect/0/enabled = true
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("AudioEffectLowPassFilter_music")
bus/1/effect/0/enabled = false
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/3/name = &"Room"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"SFX"
bus/3/effect/0/effect = SubResource("AudioEffectReverb_room")
bus/3/effect/0/enabled = false
bus/4/name = &"Score"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"Music"
