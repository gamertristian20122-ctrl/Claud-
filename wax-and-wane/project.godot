; Engine configuration file.
; Wax & Wane — Godot 4.7 project (GL Compatibility renderer for broad Android support).

config_version=5

[application]

config/name="Wax & Wane"
config/description="A little candle burns through a haunted house before 2 AM."
config/version="2.6.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://assets/art/ui/app_icon.ico"
boot_splash/bg_color=Color(0.035, 0.027, 0.035, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="WaxAndWane"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

L="*res://scripts/autoload/i18n.gd"
Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
Art="*res://scripts/autoload/art.gd"
Controls="*res://scripts/autoload/controls.gd"
RunSave="*res://scripts/game/run_save.gd"
Achievements="*res://scripts/autoload/achievements.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font="res://assets/fonts/kenney_pixel.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.027, 0.035, 1)
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
anti_aliasing/quality/msaa_2d=0
