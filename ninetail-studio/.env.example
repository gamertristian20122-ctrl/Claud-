# Server-side fallback keys. Used when a visitor has not connected their own key.
# Leave both empty to run in demo mode (prebuilt outputs, no AI calls).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Public URL of the site, e.g. https://ninetail.example.com. Sent to OpenRouter as the
# referer and accepted as an allowed Origin for builds. Only needed behind a proxy
# that rewrites the Host header.
NEXT_PUBLIC_SITE_URL=

# Checkout links for the upgrade modal (for example Stripe Payment Links).
NEXT_PUBLIC_CHECKOUT_BYOK_LIFETIME_URL=
NEXT_PUBLIC_CHECKOUT_BYOK_MONTHLY_URL=
NEXT_PUBLIC_CHECKOUT_PRO_URL=

# Set to "true" to show a "Refill demo tails" button (handy for screen recordings).
NEXT_PUBLIC_SHOW_DEMO_RESET=false

# Static hosting with no API route: every build streams a demo in the browser.
NEXT_PUBLIC_STATIC_DEMO=false
